<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsUraPlugin>true</IsUraPlugin>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>2026.9.10</Version>

    <!-- URA 插件元数据 -->
    <PluginInternalName>EventResponseAnalyzer</PluginInternalName>
    <PluginDisplayName>解析事件效果</PluginDisplayName>
    <PluginAuthor>离披</PluginAuthor>
    <PluginDescription>解析事件效果，数据来自kamigame</PluginDescription>
    <PluginChangelog>补充 ExecCommand/Load 事件解析并调整显示优先级</PluginChangelog>
    <PluginRepositoryUrl>https://github.com/URA-Plugins/EventResponseAnalyzer</PluginRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Compile Update="i18n\ParseSingleModeCheckEventResponse.Designer.cs">
      <DependentUpon>ParseSingleModeCheckEventResponse.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="i18n\ParseSingleModeCheckEventResponse.resx">
      <LastGenOutput>ParseSingleModeCheckEventResponse.Designer.cs</LastGenOutput>
      <Generator>PublicResXFileCodeGenerator</Generator>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="UmamusumeResponseAnalyzer" Version="*" PrivateAssets="all" />
  </ItemGroup>

</Project>
